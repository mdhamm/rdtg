"""Generated by RDTG for workspace '{{ config.name }}' on {{ generated }}.

Run against a target defined in rdtg.yaml (default: {{ config.default_target or "the first target" }}):
    pytest
    pytest --target "Hardware"
    pytest --target "Simulated Hardware" --target-param bugs=slow_spinup

Tests whose *setup* cannot be established (RigError) are reported as skipped/inconclusive,
not failed: the software was never put into the state the requirement talks about.
"""
import os
from pathlib import Path

import pytest

from rdtg.harness import RigError, make_rig, parse_params, release_target

PROJECT_DIR = (Path(__file__).parent / "{{ project_rel }}").resolve()


def pytest_addoption(parser):
    parser.addoption("--target", default=os.environ.get("RDTG_TARGET"),
                     help="target name from rdtg.yaml")
    parser.addoption("--target-param", action="append", default=[], metavar="KEY=VALUE",
                     help="target parameter (repeatable)")


def pytest_configure(config):
    config.addinivalue_line("markers", "requirement(id): requirement this test verifies")
    config.addinivalue_line("markers", "traces(*ids): all requirements exercised (incl. setup)")


def pytest_sessionfinish(session, exitstatus):
    release_target()


@pytest.hookimpl(hookwrapper=True)
def pytest_runtest_makereport(item, call):
    outcome = yield
    rep = outcome.get_result()
    if call.excinfo is not None and call.excinfo.errisinstance(RigError):
        rep.outcome = "skipped"
        rep.longrepr = (str(item.path), item.location[1] or 0, f"INCONCLUSIVE: {call.excinfo.value}")
    rig = getattr(item, "_rdtg_rig", None)
    if rig is not None and rep.when == "call":
        rep.sections.append(("rig transcript", "\n".join(rig.transcript)))


@pytest.fixture
def rig(request):
    params = parse_params(os.environ.get("RDTG_TARGET_PARAMS"))
    params.update(parse_params(";".join(request.config.getoption("--target-param"))))
    r = make_rig(os.environ.get("RDTG_PROJECT", PROJECT_DIR),
                 target=request.config.getoption("--target"), params=params)
    r.reset()
    request.node._rdtg_rig = r
    yield r
